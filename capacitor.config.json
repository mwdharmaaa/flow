{
  "appId": "com.flow.finance",
  "appName": "Flow",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "backgroundColor": "#0B0D14",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 300,
      "launchAutoHide": true,
      "backgroundColor": "#0B0D14",
      "showSpinner": false
    }
  }
}
